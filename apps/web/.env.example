# Copy this file to `.env` to enable local feature flags.

# Turn on the realtime room WebSocket client (Phase 6).
# Requires the relay backend to be running (see `docker compose up -d` at the
# repo root). The Vite dev server proxies /ws and /api to the relay at
# localhost:8080 (override with VITE_RELAY_PROXY_TARGET if needed).
VITE_ENABLE_REALTIME=true
